import { Theme, NavItem, AppButton, Meter, Card, FadeIn, Badge } from "theme.slint";
import { App } from "app.slint";
import { WelcomePage, Languages } from "pages/welcome.slint";
import { TextsPage, UnitEditor } from "pages/texts.slint";
import { BuildPage, Encodings } from "pages/build.slint";
import { GlossaryPage } from "pages/glossary.slint";
import { PromptPage } from "pages/prompt.slint";
import { TranslatePage } from "pages/translate.slint";
import { SettingsPage, Providers } from "pages/settings.slint";

export { App, Languages, Encodings, Providers }

component Sidebar inherits Rectangle {
    property <int> index: App.page == "texts" ? 0 : App.page == "glossary" ? 1 : App.page == "prompt" ? 2
        : App.page == "translate" ? 3 : App.page == "build" ? 4 : -1;
    // Last main-page slot, so the indicator fades in place instead of jumping while Settings is open.
    property <int> slot: max(0, root.index);
    changed index => {
        if (root.index >= 0) {
            root.slot = root.index;
        }
    }
    width: 200px;
    background: Theme.surface;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            padding-bottom: 20px;
            padding-top: 8px;
            spacing: 11px;
            alignment: start;
            Rectangle {
                width: 34px;
                height: 34px;
                border-radius: 9px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent.transparentize(0.5);
                Image {
                    source: @image-url("icons/languages.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.accent-light;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: "VnTrans";
                        color: Theme.text;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 16px;
                            border-radius: 4px;
                            background: Theme.raised;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "v0.1";
                                    color: Theme.dim;
                                    font-size: 10px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Text {
                    text: "Translation Studio";
                    color: Theme.faint;
                    font-size: 11px;
                }
            }
        }
        Rectangle {
            height: 5 * 38px + 4 * 4px;
            Rectangle {
                y: root.slot * 42px;
                height: 38px;
                border-radius: 8px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent.transparentize(0.65);
                opacity: root.index >= 0 ? 1 : 0;
                animate y { duration: 240ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                animate opacity { duration: 180ms; }
                Rectangle {
                    x: 0;
                    y: 9px;
                    width: 3px;
                    height: 20px;
                    border-radius: 1.5px;
                    background: Theme.accent-light;
                }
            }
            VerticalLayout {
                spacing: 4px;
                NavItem {
                    icon: @image-url("icons/file-text.svg");
                    text: "Texts";
                    active: root.index == 0;
                    clicked => { App.navigate("texts"); }
                }
                NavItem {
                    icon: @image-url("icons/book-open.svg");
                    text: "Glossary";
                    active: root.index == 1;
                    clicked => { App.navigate("glossary"); }
                }
                NavItem {
                    icon: @image-url("icons/sparkles.svg");
                    text: "Prompt";
                    active: root.index == 2;
                    clicked => { App.navigate("prompt"); }
                }
                NavItem {
                    icon: @image-url("icons/play.svg");
                    text: App.running ? "Translating…" : "Translate";
                    active: root.index == 3;
                    clicked => { App.navigate("translate"); }
                }
                NavItem {
                    icon: @image-url("icons/package.svg");
                    text: "Build";
                    active: root.index == 4;
                    clicked => { App.navigate("build"); }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Rectangle {
            height: 38px;
            Rectangle {
                border-radius: 8px;
                background: Theme.accent-soft;
                border-width: 1px;
                border-color: Theme.accent.transparentize(0.65);
                opacity: App.page == "settings" ? 1 : 0;
                animate opacity { duration: 180ms; }
                Rectangle {
                    x: 0;
                    y: 9px;
                    width: 3px;
                    height: 20px;
                    border-radius: 1.5px;
                    background: Theme.accent-light;
                }
            }
            NavItem {
                icon: @image-url("icons/settings.svg");
                text: "Settings";
                active: App.page == "settings";
                clicked => { App.navigate("settings"); }
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

component Header inherits Rectangle {
    height: 64px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 18px;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: App.project-name;
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 700;
                    overflow: elide;
                    vertical-alignment: center;
                }
                if App.has-ks: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 18px;
                        border-radius: 4px;
                        background: Theme.violet-soft;
                        border-width: 1px;
                        border-color: Theme.violet.transparentize(0.6);
                        HorizontalLayout {
                            padding-left: 5px;
                            padding-right: 5px;
                            Text {
                                text: "KAG/KS";
                                color: Theme.violet;
                                font-size: 10px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            Text {
                text: App.project-info;
                color: Theme.faint;
                font-size: 12px;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            width: 250px;
            HorizontalLayout {
                Text {
                    text: App.progress-text;
                    color: Theme.dim;
                    font-size: 12px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: (App.total == 0 ? 0 : floor(1000 * App.translated / App.total) / 10) + "%";
                    color: App.total > 0 && App.translated == App.total ? Theme.success : Theme.text;
                    font-size: 12px;
                    font-weight: 700;
                }
            }
            Meter {
                height: 6px;
                value: App.total == 0 ? 0 : App.translated / App.total;
                fill: App.total > 0 && App.translated == App.total ? Theme.success : Theme.accent;
            }
        }
        VerticalLayout {
            alignment: center;
            AppButton {
                icon: @image-url("icons/log-out.svg");
                text: "Close";
                enabled: !App.busy && !App.running;
                clicked => { App.close-project(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component StatusBar inherits Rectangle {
    height: 30px;
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 14px;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: App.running ? Theme.warning : Theme.success;
                }
            }
            Text {
                text: App.status-text + (App.page == "texts" ? " · " + App.shown-text + " shown" : "")
                    + (App.page == "texts" && App.sel-count > 1 ? " · " + App.sel-count + " selected" : "");
                color: Theme.dim;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        if App.busy: busy-zone := Rectangle {
            property <bool> hovered: zone.has-hover || cancel.hovered;
            horizontal-stretch: 0;
            zone := TouchArea { }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: App.busy-text;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 420px;
                }
                VerticalLayout {
                    alignment: center;
                    Meter {
                        width: 140px;
                        value: App.busy-progress;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    cancel := AppButton {
                        ghost: true;
                        height: 22px;
                        horizontal-stretch: 0;
                        icon: @image-url("icons/x.svg");
                        opacity: busy-zone.hovered ? 1 : 0;
                        animate opacity { duration: 140ms; }
                        clicked => { App.cancel-busy(); }
                    }
                }
            }
        }
        if !App.busy && App.message != "": Rectangle {
            height: 22px;
            border-radius: 4px;
            background: App.message-error ? Theme.danger-soft : Theme.accent-soft;
            border-width: 1px;
            border-color: App.message-error ? Theme.danger.transparentize(0.6) : Theme.accent.transparentize(0.6);
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: App.message;
                    color: App.message-error ? Theme.danger : Theme.accent-light;
                    font-size: 12px;
                    font-weight: 500;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
        if App.can-undo: VerticalLayout {
            alignment: center;
            AppButton {
                height: 22px;
                icon: @image-url("icons/rotate-ccw.svg");
                text: App.undo-text;
                clicked => { App.undo(); }
            }
        }
    }
}

component EditorDialog inherits Rectangle {
    in property <bool> open;
    changed open => {
        if (root.open) {
            editor.focus-translation();
        }
    }
    property <float> shown: root.open ? 1 : 0;
    animate shown { duration: 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    visible: root.shown > 0.01;
    background: #04070FB8.with-alpha(0.78 * root.shown);
    // Swallows clicks so they don't reach the page underneath; a click on the backdrop closes.
    TouchArea {
        clicked => { App.editor-open = false; }
    }
    dialog := Card {
        width: min(parent.width - 80px, 1140px);
        height: min(parent.height - 80px, 700px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1 - root.shown) * 16px;
        opacity: root.shown;
        transform-scale: 0.97 + 0.03 * root.shown;
        background: Theme.panel;
        border-radius: 12px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 40px;
        drop-shadow-color: #000000A0;
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: App.cur-speaker == "" ? "Unit " + App.cur-number : App.cur-speaker;
                            color: App.cur-speaker == "" ? Theme.text : Theme.violet;
                            font-size: 16px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        if App.cur-speaker != "": VerticalLayout {
                            alignment: center;
                            Rectangle {
                                height: 18px;
                                border-radius: 4px;
                                background: Theme.violet-soft;
                                border-width: 1px;
                                border-color: Theme.violet.transparentize(0.6);
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: "Speaker";
                                        color: Theme.violet;
                                        font-size: 10px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: (App.current + 1) + " of " + App.shown-text + " shown";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }
                AppButton {
                    icon: @image-url("icons/chevron-left.svg");
                    text: "Previous";
                    enabled: App.current > 0;
                    clicked => { App.select(App.current - 1); }
                }
                AppButton {
                    icon: @image-url("icons/chevron-right.svg");
                    text: "Next";
                    enabled: App.current + 1 < App.units.length;
                    clicked => { App.select(App.current + 1); }
                }
                Rectangle { width: 4px; }
                AppButton {
                    ghost: true;
                    icon: @image-url("icons/x.svg");
                    clicked => { App.editor-open = false; }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            editor := UnitEditor {
                text-size: 16px;
                Text {
                    text: "Ctrl+Enter saves and moves on · Esc closes";
                    color: Theme.faint;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.has-project ? App.project-name + " — VnTrans" : "VnTrans";
    icon: @image-url("icons/languages.svg");
    preferred-width: 1360px;
    preferred-height: 840px;
    min-width: 1180px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;
    // Clipboard writes go through a hidden TextInput, the only clipboard access Slint offers.
    public function copy-text(text: string) {
        clipboard.text = text;
        clipboard.select-all();
        clipboard.copy();
        clipboard.clear-selection();
    }
    clipboard := TextInput {
        visible: false;
    }
    // Clicking anywhere that isn't an input moves focus here, so fields lose focus as expected.
    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (App.editor-open) {
                    App.editor-open = false;
                } else {
                    App.clear-selection();
                }
                self.focus();
                return accept;
            }
            if (event.modifiers.control && event.text == "f" && App.has-project) {
                App.editor-open = false;
                App.page = "texts";
                App.search-request += 1;
                return accept;
            }
            reject
        }
        VerticalLayout {
            if !App.has-project: FadeIn {
                from-scale: 0.97;
                duration: 300ms;
                WelcomePage { }
            }
            if App.has-project: HorizontalLayout {
                Sidebar { }
                VerticalLayout {
                    Header { }
                    if App.page == "texts": FadeIn {
                        TextsPage { }
                    }
                    if App.page == "glossary": FadeIn {
                        GlossaryPage { }
                    }
                    if App.page == "prompt": FadeIn {
                        PromptPage { }
                    }
                    if App.page == "translate": FadeIn {
                        TranslatePage { }
                    }
                    if App.page == "build": FadeIn {
                        BuildPage { }
                    }
                    if App.page == "settings": FadeIn {
                        SettingsPage { }
                    }
                    StatusBar { }
                }
            }
        }
        if App.has-project: EditorDialog {
            width: parent.width;
            height: parent.height;
            open: App.editor-open && App.current >= 0;
        }
    }
}
