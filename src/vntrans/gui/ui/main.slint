import { Theme, NavItem, AppButton, Meter, Card, FadeIn } from "theme.slint";
import { App } from "app.slint";
import { WelcomePage, Languages } from "pages/welcome.slint";
import { TextsPage, UnitEditor } from "pages/texts.slint";
import { BuildPage, Encodings } from "pages/build.slint";
import { GlossaryPage } from "pages/glossary.slint";
import { PromptPage } from "pages/prompt.slint";
import { TranslatePage } from "pages/translate.slint";
import { SettingsPage, Providers } from "pages/settings.slint";

export { App, Languages, Encodings, Providers }

component Sidebar inherits Rectangle {
    property <int> index: App.page == "texts" ? 0 : App.page == "glossary" ? 1 : App.page == "prompt" ? 2
        : App.page == "translate" ? 3 : App.page == "build" ? 4 : -1;
    // Last main-page slot, so the indicator fades in place instead of jumping while Settings is open.
    property <int> slot: max(0, root.index);
    changed index => {
        if (root.index >= 0) {
            root.slot = root.index;
        }
    }
    width: 184px;
    background: Theme.surface;
    VerticalLayout {
        padding: 12px;
        spacing: 4px;
        HorizontalLayout {
            padding-left: 6px;
            padding-bottom: 18px;
            padding-top: 6px;
            spacing: 10px;
            alignment: start;
            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 8px;
                background: Theme.accent-soft;
                Image {
                    source: @image-url("icons/languages.svg");
                    width: 18px;
                    height: 18px;
                    colorize: Theme.accent-hover;
                }
            }
            Text {
                text: "VnTrans";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 5 * 36px + 4 * 4px;
            Rectangle {
                y: root.slot * 40px;
                height: 36px;
                border-radius: 6px;
                background: Theme.accent-soft;
                opacity: root.index >= 0 ? 1 : 0;
                animate y { duration: 260ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                animate opacity { duration: 180ms; }
                Rectangle {
                    x: 0;
                    y: 9px;
                    width: 3px;
                    height: 18px;
                    border-radius: 1.5px;
                    background: Theme.accent;
                }
            }
            VerticalLayout {
                spacing: 4px;
                NavItem {
                    icon: @image-url("icons/file-text.svg");
                    text: "Texts";
                    active: root.index == 0;
                    clicked => { App.navigate("texts"); }
                }
                NavItem {
                    icon: @image-url("icons/book-open.svg");
                    text: "Glossary";
                    active: root.index == 1;
                    clicked => { App.navigate("glossary"); }
                }
                NavItem {
                    icon: @image-url("icons/sparkles.svg");
                    text: "Prompt";
                    active: root.index == 2;
                    clicked => { App.navigate("prompt"); }
                }
                NavItem {
                    icon: @image-url("icons/play.svg");
                    text: App.running ? "Translating…" : "Translate";
                    active: root.index == 3;
                    clicked => { App.navigate("translate"); }
                }
                NavItem {
                    icon: @image-url("icons/package.svg");
                    text: "Build";
                    active: root.index == 4;
                    clicked => { App.navigate("build"); }
                }
            }
        }
        Rectangle { vertical-stretch: 1; }
        Rectangle {
            height: 36px;
            Rectangle {
                border-radius: 6px;
                background: Theme.accent-soft;
                opacity: App.page == "settings" ? 1 : 0;
                animate opacity { duration: 180ms; }
            }
            NavItem {
                icon: @image-url("icons/settings.svg");
                text: "Settings";
                active: App.page == "settings";
                clicked => { App.navigate("settings"); }
            }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.border;
    }
}

component Header inherits Rectangle {
    height: 60px;
    background: Theme.surface;
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 14px;
        spacing: 18px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            Text {
                text: App.project-name;
                color: Theme.text;
                font-size: 15px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: App.project-info;
                color: Theme.faint;
                font-size: 12px;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            width: 240px;
            HorizontalLayout {
                Text {
                    text: App.progress-text;
                    color: Theme.dim;
                    font-size: 12px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: (App.total == 0 ? 0 : floor(1000 * App.translated / App.total) / 10) + "%";
                    color: Theme.text;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
            Meter {
                height: 6px;
                value: App.total == 0 ? 0 : App.translated / App.total;
            }
        }
        VerticalLayout {
            alignment: center;
            AppButton {
                icon: @image-url("icons/log-out.svg");
                enabled: !App.busy && !App.running;
                clicked => { App.close-project(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component StatusBar inherits Rectangle {
    height: 28px;
    background: Theme.surface;
    Rectangle {
        y: 0;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 16px;
        Text {
            text: App.status-text + (App.page == "texts" ? " · " + App.shown-text + " shown" : "");
            color: Theme.faint;
            font-size: 12px;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if App.busy: busy-zone := Rectangle {
            property <bool> hovered: zone.has-hover || cancel.hovered;
            horizontal-stretch: 0;
            zone := TouchArea { }
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: App.busy-text;
                    color: Theme.dim;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 420px;
                }
                VerticalLayout {
                    alignment: center;
                    Meter {
                        width: 140px;
                        value: App.busy-progress;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    cancel := AppButton {
                        ghost: true;
                        height: 22px;
                        horizontal-stretch: 0;
                        icon: @image-url("icons/x.svg");
                        opacity: busy-zone.hovered ? 1 : 0;
                        animate opacity { duration: 140ms; }
                        clicked => { App.cancel-busy(); }
                    }
                }
            }
        }
        if !App.busy && App.message != "": Text {
            text: App.message;
            color: App.message-error ? Theme.danger : Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component EditorDialog inherits Rectangle {
    in property <bool> open;
    changed open => {
        if (root.open) {
            editor.focus-translation();
        }
    }
    property <float> shown: root.open ? 1 : 0;
    animate shown { duration: 220ms; easing: cubic-bezier(0.2, 0, 0, 1); }
    visible: root.shown > 0.01;
    background: #060A12B8.with-alpha(0.72 * root.shown);
    // Swallows clicks so they don't reach the page underneath; a click on the backdrop closes.
    TouchArea {
        clicked => { App.editor-open = false; }
    }
    dialog := Card {
        width: min(parent.width - 96px, 1100px);
        height: min(parent.height - 96px, 680px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (1 - root.shown) * 18px;
        opacity: root.shown;
        transform-scale: 0.97 + 0.03 * root.shown;
        background: Theme.panel;
        border-color: Theme.border-strong;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000090;
        TouchArea { }
        VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: App.cur-speaker == "" ? "Unit " + App.cur-number : App.cur-speaker;
                        color: App.cur-speaker == "" ? Theme.text : Theme.violet;
                        font-size: 16px;
                        font-weight: 700;
                        overflow: elide;
                    }
                    Text {
                        text: (App.current + 1) + " of " + App.shown-text + " shown";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }
                AppButton {
                    icon: @image-url("icons/chevron-left.svg");
                    text: "Previous";
                    enabled: App.current > 0;
                    clicked => { App.select(App.current - 1); }
                }
                AppButton {
                    icon: @image-url("icons/chevron-right.svg");
                    text: "Next";
                    enabled: App.current + 1 < App.units.length;
                    clicked => { App.select(App.current + 1); }
                }
                Rectangle { width: 4px; }
                AppButton {
                    ghost: true;
                    icon: @image-url("icons/x.svg");
                    clicked => { App.editor-open = false; }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            editor := UnitEditor {
                text-size: 16px;
                Text {
                    text: "Ctrl+Enter saves and moves on · Esc closes";
                    color: Theme.faint;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: App.has-project ? App.project-name + " — VnTrans" : "VnTrans";
    icon: @image-url("icons/languages.svg");
    preferred-width: 1360px;
    preferred-height: 840px;
    min-width: 1180px;
    min-height: 700px;
    background: Theme.bg;
    default-font-size: 13px;
    // Clicking anywhere that isn't an input moves focus here, so fields lose focus as expected.
    FocusScope {
        capture-key-pressed(event) => {
            if (event.text == Key.Escape) {
                if (App.editor-open) {
                    App.editor-open = false;
                }
                self.focus();
                return accept;
            }
            if (event.modifiers.control && event.text == "f" && App.has-project) {
                App.editor-open = false;
                App.page = "texts";
                App.search-request += 1;
                return accept;
            }
            reject
        }
        VerticalLayout {
            if !App.has-project: FadeIn {
                from-scale: 0.97;
                duration: 300ms;
                WelcomePage { }
            }
            if App.has-project: HorizontalLayout {
                Sidebar { }
                VerticalLayout {
                    Header { }
                    if App.page == "texts": FadeIn {
                        TextsPage { }
                    }
                    if App.page == "glossary": FadeIn {
                        GlossaryPage { }
                    }
                    if App.page == "prompt": FadeIn {
                        PromptPage { }
                    }
                    if App.page == "translate": FadeIn {
                        TranslatePage { }
                    }
                    if App.page == "build": FadeIn {
                        BuildPage { }
                    }
                    if App.page == "settings": FadeIn {
                        SettingsPage { }
                    }
                    StatusBar { }
                }
            }
        }
        if App.has-project: EditorDialog {
            width: parent.width;
            height: parent.height;
            open: App.editor-open && App.current >= 0;
        }
    }
}
