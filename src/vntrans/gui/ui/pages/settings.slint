import { LineEdit, ComboBox, SpinBox, Slider, ListView, CheckBox, TextEdit } from "../widgets.slint";
import { AboutSlint } from "std-widgets.slint";
import { Theme, Card, AppButton, Field, Label, EmptyState, Badge } from "../theme.slint";
import { App } from "../app.slint";

export global Providers {
    out property <[string]> labels: ["Google Gemini", "OpenRouter"];
    out property <[string]> reasoning: ["Default", "Minimal", "Low", "High"];
}

export component SettingsPage inherits Rectangle {
    background: Theme.bg;
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        Card {
            width: 300px;
            border-radius: 10px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 4px;
                    padding-bottom: 6px;
                    Label {
                        text: "AI TRANSLATION PROFILES";
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    AppButton {
                        icon: @image-url("../icons/plus.svg");
                        text: "New";
                        clicked => { App.profile-new(); }
                    }
                }
                if App.profiles.length == 0: EmptyState { text: "No profiles configured"; }
                if App.profiles.length > 0: ListView {
                    for profile[i] in App.profiles: Rectangle {
                        height: 56px;
                        Rectangle {
                            x: 0;
                            width: parent.width;
                            border-radius: 7px;
                            background: App.profile-current == i ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
                            border-width: 1px;
                            border-color: App.profile-current == i ? Theme.accent.transparentize(0.65) : transparent;
                            animate background, border-color { duration: 140ms; }
                            touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { App.profile-select(i); }
                            }
                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: center;
                                spacing: 2px;
                                Text {
                                    text: profile.name;
                                    color: Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: profile.detail;
                                    color: Theme.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;
            Card {
                vertical-stretch: 0;
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 18px;
                    spacing: 16px;
                    HorizontalLayout {
                        Text {
                            text: App.profile-current < 0 ? "New AI Profile" : "Edit AI Profile";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if App.profile-current >= 0: VerticalLayout {
                            alignment: center;
                            Badge {
                                text: "Active Profile";
                                tint: Theme.accent-light;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "PROFILE NAME";
                            LineEdit {
                                text <=> App.pf-name;
                                placeholder-text: "Enter profile name...";
                            }
                        }
                        Field {
                            label: "AI PROVIDER";
                            ComboBox {
                                model: Providers.labels;
                                current-index <=> App.pf-provider;
                            }
                        }
                    }
                    Field {
                        label: "API KEYS (ONE PER LINE, ROTATED AUTOMATICALLY)";
                        TextEdit {
                            height: 96px;
                            vertical-stretch: 0;
                            wrap: char-wrap;
                            text <=> App.pf-keys;
                            placeholder-text: "Enter one API key per line...";
                        }
                    }
                    Field {
                        label: "MODEL IDENTIFIER";
                        HorizontalLayout {
                            spacing: 8px;
                            LineEdit {
                                horizontal-stretch: 1;
                                text <=> App.pf-model;
                                placeholder-text: "Enter model identifier...";
                                edited => { App.pf-model-index = -1; }
                            }
                            if App.pf-models.length > 0: ComboBox {
                                width: 260px;
                                model: App.pf-models;
                                current-index <=> App.pf-model-index;
                                placeholder: "Choose a model";
                                selected(value) => { App.pf-model = value; }
                            }
                            AppButton {
                                icon: @image-url("../icons/download.svg");
                                text: App.pf-working == "fetch" ? "Fetching…" : "Fetch Models";
                                loading: App.pf-working == "fetch";
                                enabled: App.pf-working == "" && App.pf-keys != "";
                                clicked => { App.profile-fetch(); }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 12px;
                        Field {
                            label: "TEMPERATURE: " + round(App.pf-temperature * 100) / 100;
                            Slider {
                                minimum: 0;
                                maximum: 2;
                                step: 0.05;
                                value <=> App.pf-temperature;
                            }
                        }
                        Field {
                            label: "MAX OUTPUT TOKENS";
                            SpinBox {
                                minimum: 256;
                                maximum: 65536;
                                step-size: 1024;
                                value <=> App.pf-max-tokens;
                            }
                        }
                        Field {
                            label: "REASONING EFFORT";
                            ComboBox {
                                model: Providers.reasoning;
                                current-index <=> App.pf-reasoning;
                            }
                        }
                        Field {
                            label: "TIMEOUT (SEC)";
                            SpinBox {
                                minimum: 10;
                                maximum: 900;
                                step-size: 10;
                                value <=> App.pf-timeout;
                            }
                        }
                    }
                    CheckBox {
                        text: "Show the model's thinking on the Translate page";
                        checked <=> App.pf-thinking;
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        if App.pf-status != "": Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: App.pf-status-error ? Theme.danger-soft : Theme.success-soft;
                            border-width: 1px;
                            border-color: App.pf-status-error ? Theme.danger.transparentize(0.5) : Theme.success.transparentize(0.5);
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: App.pf-status;
                                    color: App.pf-status-error ? Theme.danger : Theme.success;
                                    font-size: 12px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        if App.pf-status == "": Rectangle { horizontal-stretch: 1; }
                        if App.pf-status != "": Rectangle { horizontal-stretch: 1; }
                        AppButton {
                            danger: true;
                            icon: @image-url("../icons/trash-2.svg");
                            text: "Delete";
                            enabled: App.profile-current >= 0;
                            clicked => { App.profile-delete(); }
                        }
                        AppButton {
                            icon: @image-url("../icons/play.svg");
                            text: App.pf-working == "test" ? "Testing…" : "Test Connection";
                            loading: App.pf-working == "test";
                            enabled: App.pf-working == "" && App.pf-keys != "" && App.pf-model != "";
                            clicked => { App.profile-test(); }
                        }
                        AppButton {
                            primary: true;
                            icon: @image-url("../icons/check.svg");
                            text: "Save Profile";
                            enabled: App.pf-name != "";
                            clicked => { App.profile-save(); }
                        }
                    }
                }
            }
            Card {
                vertical-stretch: 0;
                border-radius: 10px;
                border-color: Theme.border;
                HorizontalLayout {
                    padding: 18px;
                    spacing: 20px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 4px;
                        Label {
                            text: "ABOUT VNTRANS";
                            font-size: 11px;
                        }
                        Text {
                            text: "VnTrans — Lossless visual novel script extraction & translation reinsertion";
                            color: Theme.text;
                            font-weight: 600;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "Open Source under the MIT License · Built with Slint UI & Python";
                            color: Theme.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    AboutSlint {
                        width: 200px;
                        height: 96px;
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }
}
