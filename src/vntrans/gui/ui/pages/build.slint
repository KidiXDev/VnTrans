import { CheckBox, SpinBox, ComboBox, ListView } from "../widgets.slint";
import { Theme, Card, AppButton, Label, Meter, FadeIn, Badge } from "../theme.slint";
import { App, BuildRow } from "../app.slint";

export global Encodings {
    out property <[string]> output: ["Keep", "utf-8", "utf-8-sig", "utf-16-le", "cp932"];
}

component BuildColumns inherits HorizontalLayout {
    padding-left: 14px;
    padding-right: 12px;
    spacing: 12px;
}

component BuildItem inherits Rectangle {
    in property <BuildRow> item;
    in property <bool> selected;
    callback clicked;
    height: 48px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.raised : transparent;
    animate background { duration: 100ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    BuildColumns {
        Text {
            horizontal-stretch: 2;
            min-width: 0;
            preferred-width: 0;
            text: root.item.date;
            color: Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            width: 70px;
            text: root.item.files;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            width: 90px;
            text: root.item.units;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            horizontal-stretch: 2;
            min-width: 0;
            preferred-width: 0;
            text: root.item.settings;
            color: Theme.faint;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            width: 80px;
            alignment: center;
            if root.item.warnings > 0: Badge {
                text: root.item.warnings + " warn";
                tint: Theme.warning;
            }
            if root.item.warnings == 0: Text {
                text: "—";
                color: Theme.faint;
                font-size: 12px;
                horizontal-alignment: center;
            }
        }
        VerticalLayout {
            alignment: center;
            AppButton {
                ghost: true;
                width: 80px;
                height: 30px;
                icon: @image-url("../icons/external-link.svg");
                text: "Open";
                clicked => { App.open-folder(root.item.path); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border.transparentize(0.65);
    }
}

export component BuildPage inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        Card {
            vertical-stretch: 0;
            border-radius: 10px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 20px;
                spacing: 24px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: (App.total == 0 ? 0 : floor(1000 * App.translated / App.total) / 10) + "%";
                            color: App.total > 0 && App.translated == App.total ? Theme.success : Theme.text;
                            font-size: 24px;
                            font-weight: 800;
                        }
                        Text {
                            horizontal-stretch: 1;
                            text: App.progress-text + " translated";
                            color: Theme.dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    Meter {
                        height: 6px;
                        value: App.total == 0 ? 0 : App.translated / App.total;
                        fill: App.total > 0 && App.translated == App.total ? Theme.success : Theme.accent;
                    }
                    Text {
                        text: "Untranslated and excluded units keep their original game script text.";
                        color: Theme.faint;
                        font-size: 12px;
                    }
                }
                Rectangle {
                    width: 1px;
                    background: Theme.border;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        CheckBox {
                            width: 160px;
                            text: "Wrap dialogue at";
                            checked <=> App.wrap;
                        }
                        SpinBox {
                            width: 110px;
                            enabled: App.wrap;
                            minimum: 10;
                            maximum: 400;
                            value <=> App.wrap-columns;
                        }
                        Text {
                            width: 60px;
                            text: "columns";
                            color: Theme.dim;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        Text {
                            width: 160px;
                            text: "Output encoding (KS)";
                            color: App.has-ks ? Theme.text : Theme.faint;
                            vertical-alignment: center;
                        }
                        ComboBox {
                            enabled: App.has-ks;
                            model: Encodings.output;
                            current-index <=> App.output-encoding;
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            primary: true;
                            height: 40px;
                            icon: @image-url("../icons/package.svg");
                            text: App.busy ? "Building…" : "Build Patch";
                            enabled: !App.busy;
                            clicked => { App.build(); }
                        }
                        if App.busy: AppButton {
                            height: 40px;
                            icon: @image-url("../icons/x.svg");
                            clicked => { App.cancel-busy(); }
                        }
                    }
                }
            }
        }

        Card {
            vertical-stretch: 0;
            border-radius: 10px;
            border-color: Theme.border;
            HorizontalLayout {
                padding: 14px;
                padding-left: 20px;
                spacing: 10px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Label {
                        text: "LINGUAGACHA";
                    }
                    Text {
                        text: "Export MESSAGE JSON, translate it in LinguaGacha, then import its output folder.";
                        color: Theme.faint;
                        font-size: 12px;
                        overflow: elide;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppButton {
                        icon: @image-url("../icons/upload.svg");
                        text: "Export";
                        enabled: !App.busy;
                        clicked => { App.lg-export(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    AppButton {
                        icon: @image-url("../icons/download.svg");
                        text: "Import";
                        enabled: !App.busy && !App.running;
                        clicked => { App.lg-import(); }
                    }
                }
            }
        }

        if App.builds.length == 0: FadeIn {
            vertical-stretch: 1;
            Card {
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 48px;
                            height: 48px;
                            border-radius: 12px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.border;
                            Image {
                                source: @image-url("../icons/package.svg");
                                width: 24px;
                                height: 24px;
                                colorize: Theme.faint;
                            }
                        }
                    }
                    Text {
                        text: "No builds produced yet";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Each build creates a standalone translation patch folder under builds/ in the workspace.";
                        color: Theme.dim;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        if App.builds.length > 0: FadeIn {
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 12px;
                vertical-stretch: 1;
                Card {
                    horizontal-stretch: 3;
                    clip: true;
                    border-radius: 10px;
                    border-color: Theme.border;
                    VerticalLayout {
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                Label {
                                    text: "BUILD HISTORY";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: App.build-summary;
                                    color: Theme.faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                        Rectangle {
                            height: 32px;
                            background: Theme.surface;
                            BuildColumns {
                                padding-right: 12px + Theme.scrollbar;
                                Label {
                                    horizontal-stretch: 2;
                                    min-width: 0;
                                    preferred-width: 0;
                                    text: "TIMESTAMP";
                                    vertical-alignment: center;
                                }
                                Label {
                                    width: 70px;
                                    text: "FILES";
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Label {
                                    width: 90px;
                                    text: "TRANSLATED";
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                                Label {
                                    horizontal-stretch: 2;
                                    min-width: 0;
                                    preferred-width: 0;
                                    text: "SETTINGS";
                                    vertical-alignment: center;
                                }
                                Label {
                                    width: 80px;
                                    text: "STATUS";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                Rectangle { width: 80px; }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                        ListView {
                            for item[i] in App.builds: BuildItem {
                                item: item;
                                selected: App.build-current == i;
                                clicked => { App.build-select(i); }
                            }
                        }
                    }
                }
                if App.build-warnings.length > 0: FadeIn {
                    horizontal-stretch: 2;
                    from-scale: 0.98;
                    Card {
                        border-radius: 10px;
                        border-color: Theme.border;
                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;
                            Label {
                                height: 20px;
                                text: App.build-warnings.length + " WARNINGS · " + App.builds[App.build-current].date;
                            }
                            Rectangle {
                                background: Theme.field;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: Theme.border;
                                clip: true;
                                ListView {
                                    for warning in App.build-warnings: HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        padding-top: 6px;
                                        padding-bottom: 6px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: warning;
                                            color: Theme.warning;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
