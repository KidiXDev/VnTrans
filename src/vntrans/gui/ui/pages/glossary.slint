import { LineEdit, ComboBox, ListView, TextEdit, CheckBox } from "../widgets.slint";
import { Theme, Card, AppButton, Field, Label, EmptyState, Badge } from "../theme.slint";
import { App, TermRow } from "../app.slint";

component TermItem inherits Rectangle {
    in property <TermRow> term;
    in property <bool> selected;
    callback clicked;
    height: 42px;
    background: root.selected ? Theme.selected : touch.has-hover ? Theme.raised : transparent;
    animate background { duration: 100ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: root.term.source;
            color: Theme.text;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: root.term.target == "" ? "—" : root.term.target;
            color: root.term.target == "" ? Theme.faint : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            width: 82px;
            alignment: center;
            Badge {
                text: root.term.kind == "character" ? "Character" : "Term";
                tint: root.term.kind == "character" ? Theme.violet : Theme.info;
            }
        }
        Text {
            horizontal-stretch: 2;
            min-width: 0;
            preferred-width: 0;
            text: root.term.notes;
            color: Theme.dim;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            width: 76px;
            alignment: center;
            Badge {
                text: root.term.approved ? "Approved" : "Draft";
                tint: root.term.approved ? Theme.success : Theme.warning;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border.transparentize(0.65);
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component GlossaryPage inherits Rectangle {
    background: Theme.bg;
    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        HorizontalLayout {
            spacing: 10px;
            LineEdit {
                horizontal-stretch: 1;
                icon: @image-url("../icons/search.svg");
                placeholder-text: "Search terms, translations, and notes...";
                text: App.term-query;
                edited(text) => { App.term-query-edited(text); }
            }
            AppButton {
                icon: @image-url("../icons/download.svg");
                text: "Import";
                clicked => { App.term-import(); }
            }
            AppButton {
                icon: @image-url("../icons/upload.svg");
                text: "Export";
                enabled: App.term-total > 0;
                clicked => { App.term-export(); }
            }
            AppButton {
                primary: true;
                icon: @image-url("../icons/plus.svg");
                text: "Add Term";
                clicked => { App.term-new(); }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;
                Card {
                    vertical-stretch: 1;
                    clip: true;
                    border-radius: 10px;
                    border-color: Theme.border;
                    VerticalLayout {
                        Rectangle {
                            height: 34px;
                            background: Theme.surface;
                            border-top-left-radius: 10px;
                            border-top-right-radius: 10px;
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px + Theme.scrollbar;
                                spacing: 12px;
                                Label {
                                    horizontal-stretch: 1;
                                    min-width: 0;
                                    preferred-width: 0;
                                    text: "SOURCE TERM";
                                    vertical-alignment: center;
                                }
                                Label {
                                    horizontal-stretch: 1;
                                    min-width: 0;
                                    preferred-width: 0;
                                    text: "TRANSLATION";
                                    vertical-alignment: center;
                                }
                                Label {
                                    width: 82px;
                                    text: "KIND";
                                    vertical-alignment: center;
                                }
                                Label {
                                    horizontal-stretch: 2;
                                    min-width: 0;
                                    preferred-width: 0;
                                    text: "NOTES";
                                    vertical-alignment: center;
                                }
                                Label {
                                    width: 76px;
                                    text: App.terms.length + " / " + App.term-total;
                                    vertical-alignment: center;
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.border;
                            }
                        }
                        if App.terms.length == 0: EmptyState {
                            text: App.term-total == 0 ? "No glossary terms defined yet" : "No matching terms found";
                        }
                        if App.terms.length > 0: ListView {
                            for term[i] in App.terms: TermItem {
                                term: term;
                                selected: App.term-current == i;
                                clicked => { App.term-select(i); }
                            }
                        }
                    }
                }
                Card {
                    height: 175px;
                    border-radius: 10px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        HorizontalLayout {
                            Label {
                                text: "SCRIPT REPLACEMENT RULES";
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: App.rules-error != "" ? App.rules-error : "pre|post FIND => REPLACE · /regex/";
                                color: App.rules-error != "" ? Theme.danger : Theme.faint;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        TextEdit {
                            vertical-stretch: 1;
                            text <=> App.rules-text;
                            font-size: 12px;
                            placeholder-text: "Enter replacement rules (pre|post FIND => REPLACE or /regex/ => REPLACE)...";
                            edited(text) => { App.rules-edited(text); }
                        }
                    }
                }
            }
            Card {
                width: 350px;
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    HorizontalLayout {
                        Text {
                            text: App.term-current < 0 ? "New Term Entry" : "Edit Term Entry";
                            color: Theme.text;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        if App.term-current >= 0: VerticalLayout {
                            alignment: center;
                            Badge {
                                text: "#" + (App.term-current + 1);
                                tint: Theme.dim;
                            }
                        }
                    }
                    Field {
                        label: "SOURCE TERM";
                        LineEdit {
                            text <=> App.t-source;
                            placeholder-text: "Enter source term...";
                        }
                    }
                    Field {
                        label: "TARGET TRANSLATION";
                        LineEdit {
                            text <=> App.t-target;
                            placeholder-text: "Enter translation...";
                        }
                    }
                    Field {
                        label: "TERM KIND";
                        ComboBox {
                            model: ["Term", "Character"];
                            current-index <=> App.t-kind;
                        }
                    }
                    Field {
                        label: App.t-kind == 1 ? "CHARACTER NOTES (GENDER, RELATIONSHIPS, TONE)" : "USAGE NOTES";
                        vertical-stretch: 1;
                        TextEdit {
                            min-height: 72px;
                            text <=> App.t-notes;
                            placeholder-text: "Context, pronoun preferences, or honorific rules...";
                            wrap: word-wrap;
                        }
                    }
                    if App.t-evidence != "": Field {
                        label: "SCRIPT OCCURRENCE";
                        Rectangle {
                            background: Theme.field;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding: 8px;
                                Text {
                                    text: App.t-evidence;
                                    color: Theme.dim;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        CheckBox {
                            text: "Match case";
                            checked <=> App.t-case;
                        }
                        CheckBox {
                            text: "Approved";
                            checked <=> App.t-approved;
                        }
                    }
                    if App.t-error != "": Rectangle {
                        border-radius: 6px;
                        background: Theme.danger-soft;
                        border-width: 1px;
                        border-color: Theme.danger.transparentize(0.5);
                        HorizontalLayout {
                            padding: 8px;
                            Text {
                                text: App.t-error;
                                color: Theme.danger;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: end;
                        AppButton {
                            danger: true;
                            icon: @image-url("../icons/trash-2.svg");
                            text: "Delete";
                            enabled: App.term-current >= 0;
                            clicked => { App.term-delete(); }
                        }
                        AppButton {
                            primary: true;
                            icon: @image-url("../icons/check.svg");
                            text: "Save Term";
                            enabled: App.t-source != "";
                            clicked => { App.term-save(); }
                        }
                    }
                }
            }
        }
    }
}
