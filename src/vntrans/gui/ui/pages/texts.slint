import { LineEdit, ComboBox, ListView, TextEdit } from "../widgets.slint";
import { Theme, Card, AppButton, Toggle, Chip, Label, Meter, Divider, EmptyState, FadeIn, Badge } from "../theme.slint";
import { App, UnitRow } from "../app.slint";

component FileItem inherits Rectangle {
    in property <string> name;
    in property <int> total;
    in property <int> done;
    in property <bool> active;
    callback clicked;
    height: 48px;
    border-radius: 7px;
    background: root.active ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
    border-width: 1px;
    border-color: root.active ? Theme.accent.transparentize(0.65) : transparent;
    animate background, border-color { duration: 140ms; }
    VerticalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        spacing: 5px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.name;
                color: root.active ? Theme.text : touch.has-hover ? Theme.text : Theme.dim;
                font-size: 13px;
                font-weight: root.active ? 600 : 400;
                overflow: elide;
                horizontal-stretch: 1;
                animate color { duration: 120ms; }
            }
            Text {
                text: root.total == 0 ? "" : floor(100 * root.done / root.total) + "%";
                color: root.done == root.total && root.total > 0 ? Theme.success : Theme.faint;
                font-size: 11px;
                font-weight: 600;
            }
        }
        Meter {
            height: 3px;
            value: root.total == 0 ? 0 : root.done / root.total;
            fill: root.done == root.total ? Theme.success : Theme.accent;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Rows and header share these columns; the header adds the list's scrollbar gutter.
component UnitColumns inherits HorizontalLayout {
    padding-left: 10px;
    padding-right: 14px;
    spacing: 12px;
}

component MenuItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <string> shortcut;
    in property <bool> danger;
    in property <bool> enabled: true;
    callback activated;
    height: 32px;
    border-radius: 6px;
    background: touch.has-hover && root.enabled ? (root.danger ? Theme.danger-soft : Theme.raised) : transparent;
    animate background { duration: 90ms; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: !root.enabled ? Theme.faint : root.danger ? Theme.danger : Theme.dim;
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: !root.enabled ? Theme.faint : root.danger ? #FCA5A5 : Theme.text;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.shortcut != "": Text {
            text: root.shortcut;
            color: Theme.faint;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activated(); }
    }
}

component MenuSeparator inherits Rectangle {
    height: 9px;
    Rectangle {
        y: 4px;
        height: 1px;
        background: Theme.border;
    }
}

component UnitItem inherits Rectangle {
    in property <UnitRow> item;
    in property <bool> selected;
    callback pressed(bool, bool);
    callback menu(length, length);
    callback opened;
    height: 42px;
    background: root.selected ? Theme.selected : root.item.picked ? Theme.accent-soft
        : touch.has-hover ? Theme.raised : transparent;
    animate background { duration: 90ms; }
    UnitColumns {
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 3px;
                height: 22px;
                border-radius: 1.5px;
                background: Theme.kind-color(root.item.kind);
            }
        }
        Text {
            width: 52px;
            text: root.item.n;
            color: Theme.faint;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
        Text {
            width: 114px;
            text: root.item.speaker;
            color: Theme.violet;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: root.item.source;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: root.item.translation == "" ? "—" : root.item.translation;
            color: root.item.translation == "" || root.item.state == "excluded" ? Theme.faint : Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: Theme.state-color(root.item.state);
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border.transparentize(0.65);
    }
    if root.item.picked: Rectangle {
        x: 0;
        width: 2px;
        background: Theme.accent-light;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.left) {
                    root.pressed(event.modifiers.control || event.modifiers.meta, event.modifiers.shift);
                } else if (event.button == PointerEventButton.right) {
                    root.menu(self.mouse-x, self.mouse-y);
                }
            }
        }
        double-clicked => { root.opened(); }
    }
}

component ListHeader inherits Rectangle {
    height: 34px;
    background: Theme.surface;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    UnitColumns {
        padding-right: 14px + Theme.scrollbar;
        Rectangle { width: 3px; }
        Label {
            width: 52px;
            text: "#";
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Label {
            width: 114px;
            text: "SPEAKER";
            vertical-alignment: center;
        }
        Label {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: "SOURCE SCRIPT";
            vertical-alignment: center;
        }
        Label {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            text: "TRANSLATION";
            vertical-alignment: center;
        }
        Rectangle { width: 8px; }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

export component UnitEditor inherits VerticalLayout {
    in property <length> text-size: 14px;
    public function focus-translation() {
        translation.focus();
    }
    spacing: 12px;
    HorizontalLayout {
        spacing: 14px;
        vertical-stretch: 1;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label {
                    text: "ORIGINAL SOURCE";
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: App.cur-meta;
                    color: Theme.faint;
                    font-size: 11px;
                    overflow: elide;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            TextEdit {
                read-only: true;
                font-size: root.text-size;
                text: App.cur-legend == "" ? App.cur-source : App.cur-source + "\n\n" + App.cur-legend;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0;
            preferred-width: 0;
            spacing: 8px;
            HorizontalLayout {
                spacing: 8px;
                Label {
                    text: "TRANSLATION";
                    vertical-alignment: center;
                }
                Text {
                    horizontal-stretch: 1;
                    text: App.cur-state;
                    color: Theme.state-color(App.cur-state) == Theme.border ? Theme.faint : Theme.state-color(App.cur-state);
                    font-size: 11px;
                    font-weight: 600;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
            FocusScope {
                capture-key-pressed(event) => {
                    if (event.modifiers.control && event.text == Key.Return) {
                        App.save(App.cur-translation, true);
                        return accept;
                    }
                    reject
                }
                VerticalLayout {
                    translation := TextEdit {
                        text <=> App.cur-translation;
                        font-size: root.text-size;
                        enabled: App.current >= 0;
                        placeholder-text: App.current >= 0 ? "Enter translation here (Ctrl+Enter to save & advance)..." : "";
                    }
                }
            }
        }
    }
    if App.cur-suggestion != "": FadeIn {
        from-scale: 0.98;
        Rectangle {
            border-radius: 8px;
            background: Theme.violet-soft;
            border-width: 1px;
            border-color: Theme.violet.transparentize(0.5);
            HorizontalLayout {
                padding: 12px;
                spacing: 12px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 4px;
                    Text {
                        text: App.cur-suggestion;
                        color: Theme.text;
                        font-size: 13px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: App.cur-reason;
                        color: Theme.violet;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 8px;
                        AppButton {
                            text: "Dismiss";
                            clicked => { App.dismiss-suggestion(); }
                        }
                        AppButton {
                            primary: true;
                            text: "Use suggestion";
                            clicked => { App.accept-suggestion(); }
                        }
                    }
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Text {
            horizontal-stretch: 1;
            text: App.cur-error != "" ? App.cur-error : App.cur-issues;
            color: App.cur-error != "" ? Theme.danger : Theme.warning;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            overflow: elide;
        }
        @children
        AppButton {
            icon: App.cur-state == "excluded" ? @image-url("../icons/eye.svg") : @image-url("../icons/eye-off.svg");
            text: App.cur-state == "excluded" ? "Include" : "Exclude";
            enabled: App.current >= 0;
            clicked => { App.toggle-exclude(); }
        }
        AppButton {
            icon: @image-url("../icons/rotate-ccw.svg");
            text: "Revert";
            enabled: App.current >= 0;
            clicked => { App.revert(); }
        }
        AppButton {
            primary: true;
            icon: @image-url("../icons/check.svg");
            text: "Save";
            enabled: App.current >= 0;
            clicked => { App.save(App.cur-translation, false); }
        }
    }
}

export component TextsPage inherits Rectangle {
    property <length> row-height: 42px;
    property <length> menu-x;
    property <length> menu-y;
    // Opens the context menu at a point in the list area, flipping it up when it would leave the page.
    function open-menu(x: length, y: length) {
        let page-y = list-area.absolute-position.y - root.absolute-position.y + y;
        root.menu-x = min(x, list-area.width - 254px);
        root.menu-y = page-y + 370px > root.height ? y - 360px : y;
        context.show();
    }
    property <int> current: App.current;
    property <int> search-request: App.search-request;
    changed current => { root.reveal(); }
    changed search-request => {
        search.focus();
        search.select-all();
    }

    function reveal() {
        if (App.current < 0) {
            return;
        }
        if (App.current * root.row-height < -list.content-y) {
            list.content-y = -App.current * root.row-height;
        } else if ((App.current + 1) * root.row-height > -list.content-y + list.visible-height) {
            list.content-y = -((App.current + 1) * root.row-height - list.visible-height);
        }
    }

    background: Theme.bg;
    HorizontalLayout {
        Rectangle {
            width: 230px;
            background: Theme.surface;
            VerticalLayout {
                padding: 12px;
                padding-right: 8px;
                spacing: 6px;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: Theme.scrollbar;
                    Label {
                        text: "SCRIPT FILES";
                        font-size: 11px;
                        height: 24px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: App.files.length + "";
                        color: Theme.faint;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
                HorizontalLayout {
                    padding-right: Theme.scrollbar;
                    FileItem {
                        name: "All files";
                        total: App.total;
                        done: App.translated;
                        active: App.file-index == -1;
                        clicked => {
                            App.file-index = -1;
                            App.filter-changed();
                        }
                    }
                }
                HorizontalLayout {
                    padding-right: Theme.scrollbar;
                    Divider { }
                }
                ListView {
                    for file[i] in App.files: FileItem {
                        name: file.name;
                        total: file.total;
                        done: file.done;
                        active: App.file-index == i;
                        clicked => {
                            App.file-index = i;
                            App.filter-changed();
                        }
                    }
                }
            }
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Theme.border;
            }
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            VerticalLayout {
                HorizontalLayout {
                    spacing: 8px;
                    search := LineEdit {
                        icon: @image-url("../icons/search.svg");
                        placeholder-text: App.regex ? "Search regex pattern..." : "Search scripts...";
                        invalid: App.regex-error;
                        text <=> App.query;
                        edited(text) => { App.query-edited(text); }
                        if App.query != "": VerticalLayout {
                            alignment: center;
                            AppButton {
                                ghost: true;
                                height: 26px;
                                icon: @image-url("../icons/x.svg");
                                clicked => {
                                    App.query = "";
                                    App.query-edited("");
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                text: ".*";
                                checked <=> App.regex;
                                toggled => { App.filter-changed(); }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Toggle {
                                text: "Aa";
                                checked <=> App.match-case;
                                toggled => { App.filter-changed(); }
                            }
                        }
                    }
                    ComboBox {
                        width: 180px;
                        model: ["Source", "Translation", "Source + translation", "Speaker", "Unit ID"];
                        current-index <=> App.scope;
                        selected => { App.filter-changed(); }
                    }
                    ComboBox {
                        width: 140px;
                        model: ["All lines", "Dialogue", "Speaker names", "Choice", "Title"];
                        current-index <=> App.kind-index;
                        selected => { App.filter-changed(); }
                    }
                    AppButton {
                        icon: @image-url("../icons/replace.svg");
                        text: "Replace";
                        checked: App.replace-open;
                        clicked => { App.replace-open = !App.replace-open; }
                    }
                }

                // Slides open; the 8px gap lives inside so a closed bar adds no spacing.
                Rectangle {
                    height: App.replace-open ? 44px : 0;
                    clip: true;
                    animate height { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                    Rectangle {
                        y: App.replace-open ? 0 : -10px;
                        height: 44px;
                        opacity: App.replace-open ? 1 : 0;
                        animate y, opacity { duration: 200ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                        HorizontalLayout {
                            padding-top: 8px;
                            spacing: 8px;
                            LineEdit {
                                icon: @image-url("../icons/replace.svg");
                                placeholder-text: App.regex ? "Enter replacement text (\\1 inserts group 1)..." : "Enter replacement text...";
                                text <=> App.replace-with;
                            }
                            AppButton {
                                primary: true;
                                text: "Replace in " + App.shown-text + " shown";
                                enabled: App.replace-open && App.query != "" && !App.regex-error && !App.running && App.units.length > 0;
                                clicked => { App.replace-all(); }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 6px;
                for status[i] in [
                    { key: "all", label: "All" },
                    { key: "untranslated", label: "Untranslated" },
                    { key: "new", label: "New" },
                    { key: "machine", label: "Machine" },
                    { key: "edited", label: "Edited" },
                    { key: "failed", label: "Failed" },
                    { key: "excluded", label: "Excluded" },
                    { key: "issues", label: "Issues" },
                    { key: "review", label: "Review" },
                ]: Chip {
                    text: status.label;
                    count: App.counts[i];
                    checked: App.status-filter == status.key;
                    dot: status.key == "all" ? transparent : status.key == "issues" ? Theme.warning
                        : status.key == "review" ? Theme.violet : Theme.state-color(status.key);
                    clicked => {
                        App.status-filter = status.key;
                        App.filter-changed();
                    }
                }
                if App.status-filter == "issues": ComboBox {
                    width: 190px;
                    height: 28px;
                    model: ["All issues", "Source script left", "Glossary term missing", "Same as source",
                        "Line breaks differ", "Fails checks", "Speaker name added", "Furigana kept", "Quote marks wrong"];
                    current-index <=> App.issue-index;
                    selected => { App.filter-changed(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }

            Card {
                vertical-stretch: 3;
                clip: true;
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    ListHeader { }
                    list-area := Rectangle {
                        focus := FocusScope {
                            key-pressed(event) => {
                                if (event.text == Key.UpArrow && App.current > 0) {
                                    App.row-pressed(App.current - 1, false, event.modifiers.shift);
                                    return accept;
                                }
                                if (event.text == Key.DownArrow && App.current + 1 < App.units.length) {
                                    App.row-pressed(App.current + 1, false, event.modifiers.shift);
                                    return accept;
                                }
                                if ((event.modifiers.control || event.modifiers.meta) && event.text == "a") {
                                    App.select-all();
                                    return accept;
                                }
                                if ((event.modifiers.control || event.modifiers.meta) && event.text == "z") {
                                    App.undo();
                                    return accept;
                                }
                                if (event.text == Key.Delete && App.sel-has-translation) {
                                    App.menu-action("clear");
                                    return accept;
                                }
                                if (event.text == Key.Return && App.current >= 0) {
                                    App.editor-open = true;
                                    return accept;
                                }
                                reject
                            }
                            list := ListView {
                                for row[i] in App.units: UnitItem {
                                    item: row;
                                    selected: App.current == i;
                                    pressed(toggle, extend) => {
                                        focus.focus();
                                        App.row-pressed(i, toggle, extend);
                                    }
                                    menu(x, y) => {
                                        focus.focus();
                                        App.row-menu(i);
                                        root.open-menu(x, i * root.row-height + list.content-y + y);
                                    }
                                    opened => {
                                        App.select(i);
                                        App.editor-open = true;
                                    }
                                }
                            }
                        }
                        context := PopupWindow {
                            x: root.menu-x;
                            y: root.menu-y;
                            width: 250px;
                            height: menu-body.preferred-height;
                            close-policy: close-on-click-outside;
                            menu-panel := Rectangle {
                                property <bool> started;
                                Timer {
                                    interval: 1ms;
                                    running: !menu-panel.started;
                                    triggered => { menu-panel.started = true; }
                                }
                                opacity: menu-panel.started ? 1 : 0;
                                transform-scale: menu-panel.started ? 1 : 0.96;
                                animate opacity, transform-scale { duration: 140ms; easing: cubic-bezier(0.2, 0, 0, 1); }
                                background: Theme.popup;
                                border-radius: 10px;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                menu-body := VerticalLayout {
                                    padding: 6px;
                                    if App.sel-count > 1: Text {
                                        text: App.sel-count + " units selected";
                                        color: Theme.faint;
                                        font-size: 11px;
                                        height: 24px;
                                        vertical-alignment: center;
                                        x: 10px;
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/maximize-2.svg");
                                        text: "Open in editor";
                                        shortcut: "Enter";
                                        enabled: App.sel-count == 1;
                                        activated => { context.close(); App.menu-action("open"); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        icon: @image-url("../icons/copy.svg");
                                        text: "Copy source";
                                        activated => { context.close(); App.menu-action("copy-source"); }
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/copy.svg");
                                        text: "Copy translation";
                                        enabled: App.sel-has-translation;
                                        activated => { context.close(); App.menu-action("copy-translation"); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        icon: @image-url("../icons/play.svg");
                                        text: App.sel-count > 1 ? "Translate " + App.sel-count + " units" : "Translate";
                                        enabled: App.profile-names.length > 0 && !App.running;
                                        activated => { context.close(); App.menu-action("translate"); }
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/sparkles.svg");
                                        text: "Review translation";
                                        enabled: App.profile-names.length > 0 && !App.running && App.sel-has-translation;
                                        activated => { context.close(); App.menu-action("review"); }
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/check.svg");
                                        text: "Use suggestion";
                                        enabled: App.sel-has-suggestion;
                                        activated => { context.close(); App.menu-action("suggest"); }
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/x.svg");
                                        text: "Fix speaker names, furigana & quotes";
                                        enabled: App.sel-fixable;
                                        activated => { context.close(); App.menu-action("tidy"); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        icon: App.sel-all-excluded ? @image-url("../icons/eye.svg") : @image-url("../icons/eye-off.svg");
                                        text: App.sel-all-excluded ? "Include" : "Exclude";
                                        activated => { context.close(); App.menu-action("exclude"); }
                                    }
                                    MenuItem {
                                        icon: @image-url("../icons/trash-2.svg");
                                        text: App.sel-count > 1 ? "Clear translations" : "Clear translation";
                                        shortcut: "Del";
                                        danger: true;
                                        enabled: App.sel-has-translation;
                                        activated => { context.close(); App.menu-action("clear"); }
                                    }
                                    MenuSeparator { }
                                    MenuItem {
                                        icon: @image-url("../icons/check.svg");
                                        text: "Select all";
                                        shortcut: "Ctrl+A";
                                        activated => { context.close(); App.select-all(); }
                                    }
                                }
                            }
                        }
                        if App.units.length == 0: EmptyState {
                            width: parent.width;
                            height: parent.height;
                            text: App.regex-error ? "Invalid regular expression" : "No matching units found";
                        }
                    }
                }
            }

            Card {
                vertical-stretch: 0;
                height: App.cur-suggestion != "" ? 250px : 170px;
                border-radius: 10px;
                border-color: Theme.border;
                UnitEditor {
                    padding: 16px;
                    AppButton {
                        ghost: true;
                        icon: @image-url("../icons/maximize-2.svg");
                        enabled: App.current >= 0;
                        clicked => { App.editor-open = true; }
                    }
                }
            }
        }
    }
}
