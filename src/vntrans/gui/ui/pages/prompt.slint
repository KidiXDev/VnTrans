import { ComboBox, TextEdit, CheckBox } from "../widgets.slint";
import { Theme, Card, AppButton, Field, Label, Chip, Badge } from "../theme.slint";
import { App } from "../app.slint";
import { Languages } from "welcome.slint";

component SectionItem inherits Rectangle {
    in property <string> title;
    in property <bool> enabled;
    in property <bool> locked;
    in property <bool> selected;
    in property <bool> first;
    in property <bool> last;
    callback clicked;
    callback toggled;
    callback move(int);
    height: 42px;
    border-radius: 7px;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
    border-width: 1px;
    border-color: root.selected ? Theme.accent.transparentize(0.65) : transparent;
    animate background, border-color { duration: 140ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 6px;
        spacing: 8px;
        CheckBox {
            checked: root.enabled;
            enabled: !root.locked;
            toggled => { root.toggled(); }
        }
        Text {
            horizontal-stretch: 1;
            text: root.title;
            color: root.enabled ? Theme.text : Theme.faint;
            font-size: 13px;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
        }
        if !root.locked: HorizontalLayout {
            spacing: 2px;
            AppButton {
                ghost: true;
                icon: @image-url("../icons/arrow-up.svg");
                enabled: !root.first;
                clicked => { root.move(-1); }
            }
            AppButton {
                ghost: true;
                icon: @image-url("../icons/arrow-down.svg");
                enabled: !root.last;
                clicked => { root.move(1); }
            }
        }
    }
}

export component PromptPage inherits Rectangle {
    background: Theme.bg;
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            width: 300px;
            spacing: 12px;
            Card {
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;
                    Field {
                        label: "SOURCE LANGUAGE";
                        ComboBox {
                            model: Languages.sources;
                            current-index <=> App.p-source;
                            selected => { App.languages-changed(); }
                        }
                    }
                    Field {
                        label: "TARGET LANGUAGE";
                        ComboBox {
                            model: Languages.targets;
                            current-index <=> App.p-target;
                            selected => { App.languages-changed(); }
                        }
                    }
                }
            }
            Card {
                vertical-stretch: 1;
                border-radius: 10px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 12px;
                    spacing: 4px;
                    alignment: start;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-bottom: 6px;
                        Label {
                            text: "SYSTEM PROMPT SECTIONS";
                            height: 24px;
                            vertical-alignment: center;
                        }
                    }
                    for section[i] in App.sections: SectionItem {
                        title: section.title;
                        enabled: section.enabled;
                        locked: section.locked;
                        selected: App.section-current == i;
                        first: i == 0;
                        last: i >= App.sections.length - 2;
                        clicked => { App.section-select(i); }
                        toggled => { App.section-toggle(i); }
                        move(delta) => { App.section-move(i, delta); }
                    }
                }
            }
        }

        Card {
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 320px;
            border-radius: 10px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Label {
                        min-width: 80px;
                        text: App.sections[App.section-current].title;
                        font-size: 13px;
                        color: Theme.text;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if App.section-key == "style": AppButton {
                        text: "Keep honorifics";
                        clicked => { App.style-preset("Keep honorifics"); }
                    }
                    if App.section-key == "style": AppButton {
                        text: "Localize";
                        clicked => { App.style-preset("Localize"); }
                    }
                    if App.section-editable: AppButton {
                        icon: @image-url("../icons/rotate-ccw.svg");
                        text: "Reset Default";
                        clicked => { App.section-reset(); }
                    }
                }
                if App.section-about != "": Rectangle {
                    border-radius: 6px;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding: 10px;
                        Text {
                            text: App.section-about;
                            color: Theme.dim;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }
                if App.section-key == "contract" || App.section-editable: TextEdit {
                    vertical-stretch: 1;
                    text <=> App.section-text;
                    read-only: !App.section-editable;
                    placeholder-text: App.section-key == "instructions" ? "Enter instructions, tone, setting, character notes, naming rules..." : "";
                    wrap: word-wrap;
                    edited(text) => { App.section-edited(text); }
                }
                if !App.section-editable && App.section-key != "contract": Rectangle { vertical-stretch: 1; }
            }
        }

        Card {
            horizontal-stretch: 1;
            preferred-width: 0;
            min-width: 320px;
            border-radius: 10px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Label {
                        text: "LIVE PROMPT PREVIEW";
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Chip {
                        text: "System";
                        checked: !App.preview-user-tab;
                        clicked => { App.preview-user-tab = false; }
                    }
                    Chip {
                        text: "User Sample";
                        checked: App.preview-user-tab;
                        clicked => { App.preview-user-tab = true; }
                    }
                }
                if App.preview-stats != "": Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: Theme.field;
                    border-width: 1px;
                    border-color: Theme.border;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        Text {
                            text: App.preview-stats;
                            color: Theme.dim;
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                    }
                }
                TextEdit {
                    vertical-stretch: 1;
                    text: App.preview-user-tab ? App.preview-user : App.preview-system;
                    read-only: true;
                    wrap: word-wrap;
                    font-size: 12px;
                }
            }
        }
    }
}
