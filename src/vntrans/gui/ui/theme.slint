export global Theme {
    out property <color> bg: #0A0E17;
    out property <color> surface: #101623;
    out property <color> panel: #151D2E;
    out property <color> raised: #1C263C;
    out property <color> selected: #223250;
    out property <color> border: #222E46;
    out property <color> border-strong: #334366;
    out property <color> field: #0D1320;
    out property <color> popup: #162035;
    out property <color> text: #F1F5F9;
    out property <color> dim: #94A3B8;
    out property <color> faint: #5B6A82;
    out property <color> accent: #4F46E5;
    out property <color> accent-hover: #6366F1;
    out property <color> accent-soft: #4F46E526;
    out property <color> accent-light: #818CF8;
    out property <color> success: #10B981;
    out property <color> success-soft: #10B98124;
    out property <color> warning: #F59E0B;
    out property <color> warning-soft: #F59E0B24;
    out property <color> danger: #EF4444;
    out property <color> danger-soft: #EF444424;
    out property <color> info: #06B6D4;
    out property <color> info-soft: #06B6D424;
    out property <color> violet: #A855F7;
    out property <color> violet-soft: #A855F724;
    // Gutter reserved by ScrollView for its scrollbar.
    out property <length> scrollbar: 8px;

    public pure function kind-color(kind: string) -> color {
        if (kind == "speaker") { return violet; }
        if (kind == "choice") { return warning; }
        if (kind == "title") { return info; }
        return accent-light;
    }

    public pure function state-color(state: string) -> color {
        if (state == "machine") { return accent-light; }
        if (state == "edited") { return success; }
        if (state == "failed") { return danger; }
        if (state == "excluded") { return faint; }
        return border-strong;
    }
}

export component Label inherits Text {
    color: Theme.dim;
    font-size: 11px;
    font-weight: 600;
    overflow: elide;
}

export component EmptyState inherits VerticalLayout {
    in property <string> text;
    alignment: center;
    vertical-stretch: 1;
    spacing: 8px;
    Text {
        text: root.text;
        color: Theme.faint;
        font-size: 13px;
        horizontal-alignment: center;
    }
}

export component Card inherits Rectangle {
    background: Theme.panel;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
}

// Fades and settles its content in once, right after creation. Visual only, so layouts are unaffected.
export component FadeIn inherits Rectangle {
    in property <float> from-scale: 0.985;
    in property <duration> duration: 220ms;
    property <bool> started;
    Timer {
        interval: 1ms;
        running: !root.started;
        triggered => { root.started = true; }
    }
    opacity: root.started ? 1 : 0;
    transform-scale: root.started ? 1 : root.from-scale;
    animate opacity, transform-scale { duration: root.duration; easing: cubic-bezier(0.2, 0, 0, 1); }
    HorizontalLayout {
        @children
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent-light;
    in property <color> fill: root.tint.transparentize(0.86);
    height: 20px;
    border-radius: 4px;
    background: root.fill;
    border-width: 1px;
    border-color: root.tint.transparentize(0.65);
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: root.tint;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

export component Spinner inherits Rectangle {
    in property <length> size: 16px;
    in property <brush> tint: Theme.accent-light;
    width: root.size;
    height: root.size;
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint.transparentize(0.8);
        stroke-width: max(1.5px, root.size / 9);
        commands: "M 21 12 A 9 9 0 1 1 3 12 A 9 9 0 1 1 21 12";
    }
    Path {
        width: root.size;
        height: root.size;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: root.tint;
        stroke-width: max(1.5px, root.size / 9);
        stroke-line-cap: round;
        commands: "M 21 12 A 9 9 0 0 1 12 21";
        transform-rotation: mod(animation-tick() / 1ms * 0.36, 360) * 1deg;
    }
}

export component AppButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> primary;
    in property <bool> ghost;
    in property <bool> danger;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <bool> loading;
    out property <bool> hovered: touch.has-hover;
    callback clicked;
    height: 34px;
    border-radius: 7px;
    border-width: root.primary || root.ghost ? 0 : 1px;
    border-color: root.checked ? Theme.accent : root.danger ? Theme.danger.transparentize(0.5) : touch.has-hover && root.enabled ? Theme.border-strong : Theme.border;
    opacity: root.enabled || root.loading ? 1 : 0.45;
    background: root.primary
        ? (touch.has-hover && root.enabled ? Theme.accent-hover : Theme.accent)
        : root.danger ? (touch.has-hover && root.enabled ? Theme.danger : Theme.danger-soft)
        : root.checked ? Theme.accent-soft
        : root.ghost ? (touch.has-hover && root.enabled ? Theme.raised : transparent)
        : (touch.has-hover && root.enabled ? Theme.selected : Theme.raised);
    transform-scale: touch.pressed && root.enabled ? 0.96 : 1;
    animate background, border-color { duration: 140ms; }
    animate transform-scale { duration: 110ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 14px;
        spacing: 7px;
        alignment: center;
        if root.loading: VerticalLayout {
            alignment: center;
            Spinner {
                size: 15px;
                tint: root.primary ? #FFFFFF : root.danger ? Theme.danger : Theme.text;
            }
        }
        if root.icon.width > 0 && !root.loading: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                colorize: root.primary ? #FFFFFF : root.danger ? (touch.has-hover ? #FFFFFF : Theme.danger) : Theme.text;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.primary ? #FFFFFF : root.danger ? (touch.has-hover ? #FFFFFF : #FCA5A5) : Theme.text;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled && !root.loading;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    callback toggled;
    width: 30px;
    height: 26px;
    border-radius: 6px;
    background: root.checked ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent.transparentize(0.6) : transparent;
    animate background, border-color { duration: 140ms; }
    Text {
        text: root.text;
        color: root.checked ? Theme.accent-light : Theme.faint;
        animate color { duration: 140ms; }
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> checked;
    in property <color> dot: transparent;
    callback clicked;
    height: 28px;
    horizontal-stretch: 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.checked ? Theme.accent : touch.has-hover ? Theme.border-strong : Theme.border;
    background: root.checked ? Theme.accent-soft : touch.has-hover ? Theme.raised : transparent;
    transform-scale: touch.pressed ? 0.95 : 1;
    animate background, border-color { duration: 160ms; }
    animate transform-scale { duration: 110ms; easing: ease-out; }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: root.count != "" ? 5px : 10px;
        spacing: 6px;
        if root.dot != transparent: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.dot;
            }
        }
        Text {
            text: root.text;
            color: root.checked ? Theme.text : Theme.dim;
            font-size: 12px;
            font-weight: root.checked ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 160ms; }
        }
        if root.count != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                border-radius: 9px;
                background: root.checked ? Theme.accent.transparentize(0.65) : Theme.field;
                border-width: 1px;
                border-color: root.checked ? Theme.accent.transparentize(0.4) : Theme.border;
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    Text {
                        text: root.count;
                        color: root.checked ? Theme.text : Theme.dim;
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> active;
    in property <bool> loading;
    callback clicked;
    height: 38px;
    border-radius: 8px;
    background: !root.active && touch.has-hover ? Theme.raised : transparent;
    animate background { duration: 140ms; }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 11px;
        alignment: start;
        if root.loading: VerticalLayout {
            alignment: center;
            Spinner { size: 17px; }
        }
        if !root.loading: VerticalLayout {
            alignment: center;
            Image {
                source: root.icon;
                width: 17px;
                height: 17px;
                colorize: root.active ? Theme.accent-light : Theme.dim;
                animate colorize { duration: 180ms; }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.text;
            color: root.active ? Theme.text : Theme.dim;
            font-size: 13px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            animate color { duration: 180ms; }
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Meter inherits Rectangle {
    in property <float> value;
    in property <color> fill: Theme.accent;
    height: 5px;
    border-radius: 2.5px;
    background: Theme.field;
    border-width: 1px;
    border-color: Theme.border.transparentize(0.5);
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 2.5px;
        background: root.fill;
        animate width { duration: 450ms; easing: cubic-bezier(0.2, 0, 0, 1); }
        animate background { duration: 300ms; }
    }
}

export component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 6px;
    vertical-stretch: 0;
    Label { text: root.label; }
    @children
}
